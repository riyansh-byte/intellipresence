{
  "name": "IntelliPresence - Daily Attendance Digest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 18 * * 1-5"
            }
          ]
        }
      },
      "id": "node-cron-trigger",
      "name": "Every Weekday at 6:00 PM",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:5000/api/analytics/overview",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "node-fetch-analytics",
      "name": "Fetch Daily Analytics Overview",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [460, 300]
    },
    {
      "parameters": {
        "channel": "#daily-executive-briefing",
        "text": "=📊 *Daily Campus Attendance Summary — {{ $now.toFormat('yyyy-MM-dd') }}*\n\n• *Present Students:* {{ $json.data.today.present }}\n• *Absent Students:* {{ $json.data.today.absent }}\n• *Late Check-ins:* {{ $json.data.today.late }}\n• *Overall Campus Rate:* {{ $json.data.today.percentage }}%\n• *Total Lectures Conducted Today:* {{ $json.data.totals.sessions_run }}\n\n_Auto-generated by IntelliPresence Workflow Engine._"
      },
      "id": "node-post-digest",
      "name": "Post Digest to Leadership Channel",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [680, 300]
    }
  ],
  "connections": {
    "Every Weekday at 6:00 PM": {
      "main": [
        [
          {
            "node": "Fetch Daily Analytics Overview",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Daily Analytics Overview": {
      "main": [
        [
          {
            "node": "Post Digest to Leadership Channel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
