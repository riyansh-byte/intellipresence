{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EnforceTLSRequestsOnly",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::attendai-classroom-captures",
        "arn:aws:s3:::attendai-classroom-captures/*",
        "arn:aws:s3:::attendai-reports-storage",
        "arn:aws:s3:::attendai-reports-storage/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    }
  ]
}
